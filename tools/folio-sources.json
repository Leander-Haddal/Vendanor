  "fields": [
    {
      "key": "flag",
      "label": "Flag state",
      "type": "select",
      "options": [
        {
          "value": "NO",
          "label": "Norway"
        },
        {
          "value": "other",
          "label": "Another flag state"
        }
      ],
      "help": "The Norwegian cargo-ship rules specify Norwegian ships. The 12-passenger instrument also covers foreign vessels in the specified waters.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s1"
      }
    },
    {
      "key": "shipType",
      "label": "Ship type",
      "type": "select",
      "options": [
        {
          "value": "cargo",
          "label": "Cargo ship"
        },
        {
          "value": "passenger",
          "label": "Passenger ship"
        },
        {
          "value": "fishing",
          "label": "Fishing vessel"
        },
        {
          "value": "recreational",
          "label": "Recreational craft"
        },
        {
          "value": "other",
          "label": "Other class"
        }
      ],
      "help": "Use the vessel’s statutory class. The Norwegian small cargo-ship regulations name cargo ships.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s1"
      }
    },
    {
      "key": "lengthL",
      "label": "Regulatory length (L)",
      "type": "number",
      "unit": "m",
      "help": "Use the length defined in the Load Lines Convention applicable when the ship was built. Consult the vessel’s statutory particulars.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s5"
      }
    },
    {
      "key": "lengthOverall",
      "label": "Length overall (største lengde)",
      "type": "number",
      "unit": "m",
      "help": "Enter the overall length recorded for the vessel. Sections 1 and 2 use different length measurements.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s2"
      }
    },
    {
      "key": "grossTonnage",
      "label": "Gross tonnage",
      "type": "number",
      "unit": "GT",
      "help": "Use the gross tonnage figure on the tonnage certificate. Cargo mass is recorded in a separate field.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s1"
      }
    },
    {
      "key": "passengers",
      "label": "Passengers carried",
      "type": "number",
      "unit": "people",
      "help": "The original 12-passenger regulation sets an upper limit of 12 passengers, subject to its stated activities and exclusions.",
      "source": {
        "versionId": "no-pax-2020",
        "sectionId": "s1"
      }
    },
    {
      "key": "norwegianWaters",
      "label": "Operating in the waters of § 1",
      "type": "select",
      "options": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        }
      ],
      "help": "Norwegian territorial waters, including those at Svalbard, and rivers and lakes covered by the Norwegian 12-passenger regulation.",
      "source": {
        "versionId": "no-pax-2020",
        "sectionId": "s1"
      }
    },
    {
      "key": "buildDate",
      "label": "Date built",
      "type": "date",
      "help": "Use the statutory build date. The post-1998 wheelhouse-visibility clause turns on the date built.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s19-1"
      }
    },
    {
      "key": "contractDate",
      "label": "Build contract signed",
      "type": "date",
      "help": "The transitional rule uses the contract date together with the date of delivery.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s9"
      }
    },
    {
      "key": "deliveryDate",
      "label": "Date delivered",
      "type": "date",
      "help": "Supply the contractual delivery record for the transition test in § 9.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s9"
      }
    },
    {
      "key": "keelDate",
      "label": "Keel laid or equivalent stage",
      "type": "date",
      "help": "The transition rule gives a separate date for ships built without a contract.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s9"
      }
    },
    {
      "key": "hasBuildContract",
      "label": "Built under a contract",
      "type": "select",
      "options": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        }
      ],
      "help": "Select the applicable construction route before evaluating transitional dates.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s9"
      }
    },
    {
      "key": "lastSurveyDate",
      "label": "Last qualifying vessel-instruction survey",
      "type": "date",
      "help": "Use the full or periodic control by an approved undertaking under § 149. For the 2014 text see § 83, which refers to the full or periodic simplified control. The six-month early window may preserve an earlier anniversary.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s149"
      }
    },
    {
      "key": "wheelhouse",
      "label": "Has a wheelhouse",
      "type": "select",
      "options": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        }
      ],
      "help": "Section 19(1) includes this condition for the post-1998 visibility requirements.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s19-1"
      }
    },
    {
      "key": "tows",
      "label": "Will tow",
      "type": "select",
      "options": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        }
      ],
      "help": "Towing is one of the operations triggering a vessel instruction under § 2(1).",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s2"
      }
    },
    {
      "key": "anchorHandling",
      "label": "Will handle anchors",
      "type": "select",
      "options": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        }
      ],
      "help": "Apply the definition in § 5(a) when completing the § 2(1)(b) test.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s2"
      }
    },
    {
      "key": "cargoMassKg",
      "label": "Maximum cargo carried",
      "type": "number",
      "unit": "kg",
      "help": "Use maximum carried cargo mass. The threshold in § 2(1)(c) is strictly greater than 1,000 kg.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s2"
      }
    },
    {
      "key": "heelingArmM",
      "label": "Heeling arm from lifting",
      "type": "number",
      "unit": "m",
      "help": "Use the heeling arm from the lifting appliance. The original 2014 rule defines the arm as heeling moment divided by displacement.",
      "source": {
        "versionId": "no-cargo-2014",
        "sectionId": "s1"
      }
    },
    {
      "key": "offshoreTransfer",
      "label": "Transfers people to offshore renewable installations",
      "type": "select",
      "options": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        }
      ],
      "help": "The activity described in § 2(1)(e) includes transfer between ship and an installation for offshore renewable electricity production.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s2"
      }
    },
    {
      "key": "approvedTraining",
      "label": "Approved recreational competency training",
      "type": "select",
      "options": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        }
      ],
      "help": "Section 1(4) concerns approved educational establishments providing training for recreational-craft certificates of competence.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s1"
      }
    },
    {
      "key": "onlyPassenger2020",
      "label": "Exclusively within the 2020 passenger rules",
      "type": "select",
      "options": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        }
