      "help": "Confirm both coverage under Regulation 2020-01-14-63 and exclusive operation as described there, assessed at the relevant date.",
      "source": {
        "versionId": "no-cargo-2025",
        "sectionId": "s1"
      }
    },
    {
      "key": "onlyPassenger2009",
      "label": "Exclusively within the 2009 passenger rules",
      "type": "select",
      "options": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        }
