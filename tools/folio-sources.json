      "excerpts": [
        {
          "id": "s19-1",
          "number": "§ 19(1)",
          "title": "Sikt fra styrehus – skip bygget 1. juli 1998 eller senere",
          "begin": [
            5,
            "(1) Skip med største lengde 12 meter eller mer som er bygget"
          ],
          "end": [
            6,
            "(2) Skip med største lengde 12 meter eller mer som er bygget"
          ],
